      IOMUXC_GPIO_AD_01_MIC_BITSTREAM00,      /* GPIO_AD_01 is configured as MIC_BITSTREAM00 */
      0U);                                    /* Software Input On Field: Input Path is determined by functionality */
  IOMUXC_SetPinMux(
      IOMUXC_GPIO_AD_02_MIC_BITSTREAM01,      /* GPIO_AD_02 is configured as MIC_BITSTREAM01 */
      0U);                                    /* Software Input On Field: Input Path is determined by functionality */
  IOMUXC_SetPinMux(
      IOMUXC_GPIO_AD_03_MIC_BITSTREAM02,      /* GPIO_AD_03 is configured as MIC_BITSTREAM02 */
      0U);                                    /* Software Input On Field: Input Path is determined by functionality */
  IOMUXC_SetPinMux(
      IOMUXC_GPIO_AD_04_MIC_BITSTREAM03,      /* GPIO_AD_04 is configured as MIC_BITSTREAM03 */
      0U);                                    /* Software Input On Field: Input Path is determined by functionality */
}


/*
 * TEXT BELOW IS USED AS SETTING FOR TOOLS *************************************
Board_InitEcatStateLedPins:
- options: {callFromInitBoot: 'false', coreID: cm33, enableClock: 'true'}
- pin_list:
  - {pin_num: A14, peripheral: RGPIO6, signal: 'gpio_io, 03', pin_signal: GPIO_B1_03, identifier: ECAT_LED_RUN, direction: OUTPUT, pdrv_config: Normal_Driver, open_drain: Disable}
  - {pin_num: E12, peripheral: RGPIO6, signal: 'gpio_io, 02', pin_signal: GPIO_B1_02, identifier: ECAT_LED_ERR, direction: OUTPUT, pull_down_pull_up_config: Pull_Down,
    pdrv_config: Normal_Driver}
 * BE CAREFUL MODIFYING THIS COMMENT - IT IS YAML SETTINGS FOR TOOLS ***********
 */

/* FUNCTION ************************************************************************************************************
 *
 * Function Name : Board_InitEcatStateLedPins, assigned for the Cortex-M33 core.
 * Description   : Configures pin routing and optionally pin electrical features.
 *
 * END ****************************************************************************************************************/
void Board_InitEcatStateLedPins(void) {
  CLOCK_EnableClock(kCLOCK_Iomuxc1);          /* Turn on LPCG: LPCG is ON. */

  /* GPIO configuration of ECAT_LED_ERR on GPIO_B1_02 (pin E12) */
  rgpio_pin_config_t ECAT_LED_ERR_config = {
      .pinDirection = kRGPIO_DigitalOutput,
      .outputLogic = 0U,
  };
  /* Initialize GPIO functionality on GPIO_B1_02 (pin E12) */
  RGPIO_PinInit(RGPIO6, 2U, &ECAT_LED_ERR_config);

  /* GPIO configuration of ECAT_LED_RUN on GPIO_B1_03 (pin A14) */
  rgpio_pin_config_t ECAT_LED_RUN_config = {
      .pinDirection = kRGPIO_DigitalOutput,
      .outputLogic = 0U,
  };
  /* Initialize GPIO functionality on GPIO_B1_03 (pin A14) */
  RGPIO_PinInit(RGPIO6, 3U, &ECAT_LED_RUN_config);

  IOMUXC_SetPinMux(
      IOMUXC_GPIO_B1_02_GPIO6_IO02,           /* GPIO_B1_02 is configured as GPIO6_IO02 */
      0U);                                    /* Software Input On Field: Input Path is determined by functionality */
  IOMUXC_SetPinMux(
      IOMUXC_GPIO_B1_03_GPIO6_IO03,           /* GPIO_B1_03 is configured as GPIO6_IO03 */
      0U);                                    /* Software Input On Field: Input Path is determined by functionality */
  IOMUXC_SetPinConfig(
      IOMUXC_GPIO_B1_02_GPIO6_IO02,           /* GPIO_B1_02 PAD functional properties : */
      0x0AU);                                 /* PDRV Field: normal driver
                                                 Pull Down Pull Up Field: PD
                                                 Open Drain Field: Disabled */
  IOMUXC_SetPinConfig(
      IOMUXC_GPIO_B1_03_GPIO6_IO03,           /* GPIO_B1_03 PAD functional properties : */
      0x0AU);                                 /* PDRV Field: normal driver
                                                 Pull Down Pull Up Field: PD
                                                 Open Drain Field: Disabled */
}

